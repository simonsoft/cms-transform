<grammar xmlns="http://relaxng.org/ns/structure/1.0">
	<start>
		<ref name="document"/>
	</start>
	<define name="document">
		<element name="document">
			<ref name="attributes"/>
			<ref name="title"/>
			<optional>
				<element name="subtitle">
					<ref name="attributes"/>
					<text/>
				</element>
			</optional>
			<element name="body">
				<ref name="attributes"/>
				<zeroOrMore>
					<ref name="section"/>
				</zeroOrMore>
			</element>
		</element>
	</define>
	<define name="section">
		<element name="section">
			<ref name="attributes"/>
			<ref name="title"/>
			<zeroOrMore>
				<element name="p">
					<ref name="attributes"/>
					<text/>
				</element>
			</zeroOrMore>
		</element>
	</define>
	<define name="title">
		<element name="title">
			<ref name="attributes"/>
			<text/>
		</element>
	</define>
	<define name="attributes">
		<zeroOrMore>
			<attribute>
				<anyName/>
			</attribute>
		</zeroOrMore>
	</define>
</grammar>
